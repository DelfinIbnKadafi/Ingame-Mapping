
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pawn: Build current file",
      "type": "process",
      "command": "C:\\Projects\\Pawn\\compiler\\pawncc.exe",
      "args": [
        "${file}",
        "-D${fileDirname}",
        "-iC:\\Projects\\Pawn\\Ingame-Mapping\\includes",
        "-;+",
        "-(+",
        "-d3"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
